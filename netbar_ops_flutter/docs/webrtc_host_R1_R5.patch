+// inflight CAS 防重入(Rediscover 内部另有 rediscovering_ CAS,与 D 巡检/设置面板的手动重跑并发时自然合并)。
+void WebRTCHost::CheckDiscoveryRefresh() {
+    if (!g_sfu_ingest_accel_enabled.load(std::memory_order_relaxed)) return;
+    if (g_ingest_relay_forward.load(std::memory_order_relaxed)) return;        // forward 态不刷:不动正在用的台
+    if (g_relay_demote_inflight.load(std::memory_order_relaxed)) return;       // 降级链正在读名单
+    if (g_relay_forward_deadline_ms.load(std::memory_order_relaxed) != 0) return;  // 切换悬决
+    if (!turn_discovery_) return;
+    const int64_t now = IngestNowMs();
+    const int64_t last = g_discovery_refresh_last_ms.load(std::memory_order_relaxed);
+    if (last == 0) {  // 首拍只记时:Start() 首轮发现刚跑过,不立刻重跑
+        g_discovery_refresh_last_ms.store(now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - last < kDiscoveryRefreshIntervalMs) return;
+    bool expected = false;
+    if (!g_discovery_refresh_inflight.compare_exchange_strong(expected, true)) return;
+    g_discovery_refresh_last_ms.store(now, std::memory_order_relaxed);
+    RLOGI("Discovery", "direct", "periodic rediscover dispatched (interval="
+          << (kDiscoveryRefreshIntervalMs / 1000) << "s; independent of forward-first mission/manual pin)");
+    SpawnBackgroundThread("discovery_refresh", [this]() {
+        if (!shutting_down_.load() && turn_discovery_) turn_discovery_->Rediscover("periodic");
+        g_discovery_refresh_inflight.store(false, std::memory_order_relaxed);
+    });
+}
